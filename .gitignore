# ---- never commit the game or anything made from it ----
# (archives, executables, carved files, shaders, textures, models, audio, reports that quote game data)
reports/
work/
# game copies live under game/; only the version file lists (names, sizes, hashes) are tracked
/game/*
!/game/*.json
/assets/*
!/assets/logo.png
# the launcher's own art (drawn for this project, not the game's)
!/assets/launcher/
carve/
*.rpf
*.ttpf
*.xvd
*.msixvc
*.dxbc
*.fssm
*.spv
*.spvasm
# except translator test references, which come from hand-written shaders
!/tests/translator/expected/*.spvasm
*.dds
*.bk2
*.awc
*.r9modeldata
temp

# ---- build output and caches ----
build/
bin/
obj/
__pycache__/
*.pyc
*.exe
*.dll
*.pdb
*.ilk
*.lib
*.exp
*.log
.vs/

# ---- local Python environment ----
.venv/
